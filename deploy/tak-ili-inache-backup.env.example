# Copy to /etc/tak-ili-inache-backup.env (root:root, 0600); never commit real values.
# Provider-neutral restic/S3 configuration. Use any private S3-compatible bucket
# outside this Sprintbox account, with a dedicated least-privilege credential.
RESTIC_REPOSITORY=s3:https://replace_with_s3_endpoint/replace_with_private_bucket/tak-ili-inache
RESTIC_PASSWORD_FILE=/etc/tak-ili-inache-restic-password
AWS_ACCESS_KEY_ID=replace_with_dedicated_s3_access_key
AWS_SECRET_ACCESS_KEY=replace_with_dedicated_s3_secret_key
AWS_DEFAULT_REGION=replace_with_s3_region
RESTIC_CACHE_DIR=/var/cache/tak-ili-inache-restic
TAK_ILI_INACHE_BACKUP_MAX_AGE_HOURS=30
TAK_ILI_INACHE_BACKUP_KEEP_DAILY=14
TAK_ILI_INACHE_BACKUP_KEEP_WEEKLY=8
TAK_ILI_INACHE_BACKUP_KEEP_MONTHLY=12

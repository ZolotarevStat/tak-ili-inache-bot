# Root-only Grafana Cloud metrics credentials. Copy through sudoedit after the
# v6 installer precreates /etc/tak-ili-inache-grafana.env (0600 root:root).
# Do not put a Telegram alert-bot token on this VDS: it belongs in Grafana Cloud.
GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-<stack>.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USERNAME=<numeric-instance-id>
GRAFANA_CLOUD_METRICS_API_KEY=<metrics-write-only-api-key>

# Copy only to /etc/tak-ili-inache.env (root:takiliinache, 0640); never commit.
TELEGRAM_BOT_TOKEN=replace_with_production_bot_token
TAK_ILI_INACHE_DATA_DIR=/var/lib/tak-ili-inache
TAK_ILI_INACHE_ADMIN_IDS=replace_with_comma_separated_numeric_admin_ids
TOURNAMENT_CHAT_ID=replace_with_numeric_production_group_chat_id
# Current release default is ipv6 because the observed Telegram IPv4 route timed out.
# Allowed override values after an intentional route revalidation: ipv6, auto, ipv4.
TAK_ILI_INACHE_TELEGRAM_ADDRESS_FAMILY=ipv6
